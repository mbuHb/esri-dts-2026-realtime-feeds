# ArcGIS Velocity settings for the start-velocity scripts.
# Copy this file to .env and fill it in. .env is git-ignored — never commit it.

# vehicles feed: the HTTP Receiver URL from the feed's details page
VEHICLES_RECEIVER_URL=
# Only if the feed uses basic authentication
VEHICLES_USERNAME=
VEHICLES_PASSWORD=

# drones feed: the HTTP Receiver URL from the feed's details page
DRONES_RECEIVER_URL=
# Only if the feed uses basic authentication
DRONES_USERNAME=
DRONES_PASSWORD=
SIMULATOR_DIR=